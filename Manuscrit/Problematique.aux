\@writefile{toc}{\contentsline {subsection}{\numberline {2.2.1}Contexte opérationnel : La maîtrise du spectre électromagnétique}{13}{subsection.2.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Visualisation de l'apport tactique. Le système transforme un environnement EM (haut) en une situation tactique intelligible (bas), permettant la localisation et la classification des plateformes présentes.}}{14}{figure.caption.3}\protected@file@percent }
\newlabel{fig:apport_tactic}{{2.1}{14}{Visualisation de l'apport tactique. Le système transforme un environnement EM (haut) en une situation tactique intelligible (bas), permettant la localisation et la classification des plateformes présentes}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2.2}Chaîne de traitement de l'information}{15}{subsection.2.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2.3}Architecture et fonctionnement du capteur}{15}{subsection.2.2.3}\protected@file@percent }
\newlabel{seq:CapFonc}{{2.2.3}{15}{Architecture et fonctionnement du capteur}{subsection.2.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Illustration de la chaîne de traitement de l'information passant par le capteur ESM. La vérité terrain dicte l'émission d'impulsions, le signal physique est intercepté et les PDW sont déterminées par le capteur (encadré en pointillés noirs). Ces informations sont post-traitées (désentrelacement, pistage) et analysées (identification) pour produire un renseignement exploitable sur la vérité terrain initiale et pouvoir prendre les contre-mesures nécessaires.}}{15}{figure.caption.4}\protected@file@percent }
\newlabel{fig:env0}{{2.2}{15}{Illustration de la chaîne de traitement de l'information passant par le capteur ESM. La vérité terrain dicte l'émission d'impulsions, le signal physique est intercepté et les PDW sont déterminées par le capteur (encadré en pointillés noirs). Ces informations sont post-traitées (désentrelacement, pistage) et analysées (identification) pour produire un renseignement exploitable sur la vérité terrain initiale et pouvoir prendre les contre-mesures nécessaires}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.3}Description de l'environnement virtuel}{17}{section.2.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3.1}Motivations}{17}{subsection.2.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Visualisation d'un flux d'impulsions intercepté par un capteur ESM lors d'une campagne d'essai, mettant en évidence la structure temporelle par paquets des émissions RADAR. Les trois sous-graphiques superposés détaillent l'évolution des paramètres scalaires \textit  {Fréquence}, \textit  {Durée}, \textit  {Amplitude} de chaque PDW en fonction de sa date d'arrivée. La vue locale (bas) correspond à un facteur d'agrandissement de 25 par rapport à la vue globale (haut), ce qui permet d'observer la structure du signal et révèle sur l'axe de l'amplitude la modulation caractéristique du lobe de balayage d'antenne du RADAR émetteur.}}{18}{figure.caption.5}\protected@file@percent }
\newlabel{fig:dragon}{{2.3}{18}{Visualisation d'un flux d'impulsions intercepté par un capteur ESM lors d'une campagne d'essai, mettant en évidence la structure temporelle par paquets des émissions RADAR. Les trois sous-graphiques superposés détaillent l'évolution des paramètres scalaires \textit {Fréquence}, \textit {Durée}, \textit {Amplitude} de chaque PDW en fonction de sa date d'arrivée. La vue locale (bas) correspond à un facteur d'agrandissement de 25 par rapport à la vue globale (haut), ce qui permet d'observer la structure du signal et révèle sur l'axe de l'amplitude la modulation caractéristique du lobe de balayage d'antenne du RADAR émetteur}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3.2}Architecture et fonctionnement de l'environnement virtuel}{18}{subsection.2.3.2}\protected@file@percent }
\newlabel{seq:VEexplication}{{2.3.2}{18}{Architecture et fonctionnement de l'environnement virtuel}{subsection.2.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.4}{\ignorespaces Représentation dans un plan temps-fréquence des informations conceptuelles transitant dans la chaîne de traitement, visualisées à l'étape précédant (gauche) et succédant (droite) à la modélisation du processus de DCI (Détection et Caractérisation des Impulsions). La couleur de chaque rectangle encode l'amplitude du PDW. Les annotations identifient les dégradations structurelles induites par la chaîne de traitement : (a) Fusion de signaux distincts, (b) Disparition d'impulsion (non-détection), (c) Scission artificielle d'une impulsion continue, (d) Troncature avant, (e) Troncature arrière}}{19}{figure.caption.6}\protected@file@percent }
\newlabel{fig:IOex}{{2.4}{19}{Représentation dans un plan temps-fréquence des informations conceptuelles transitant dans la chaîne de traitement, visualisées à l'étape précédant (gauche) et succédant (droite) à la modélisation du processus de DCI (Détection et Caractérisation des Impulsions). La couleur de chaque rectangle encode l'amplitude du PDW. Les annotations identifient les dégradations structurelles induites par la chaîne de traitement : (a) Fusion de signaux distincts, (b) Disparition d'impulsion (non-détection), (c) Scission artificielle d'une impulsion continue, (d) Troncature avant, (e) Troncature arrière}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces Illustration de la chaîne de traitement de l'information passant par le capteur ESM dans le cadre d'une acquisition réelle (haut) et dans le cadre de l'utilisation d'un environnement virtuel (bas). Un VE modélise de manière comportementale la physique, à partir de l'émission des impulsions jusqu'à la caractérisation des PDW. Le périmètre du VE (encadré en pointillés bleus) comprend à la fois le périmètre du capteur (encadré en pointillés noir) et l'émission des impulsions à partir du scénario tactique. Ces PDW ainsi générés sont fidèles à ceux qui aurait été saisis lors d'une campagne d'acquisition et peuvent être utilisés pour évaluer le fonctionnement des algorithmes de post-traitement.}}{19}{figure.caption.7}\protected@file@percent }
\newlabel{fig:env1}{{2.5}{19}{Illustration de la chaîne de traitement de l'information passant par le capteur ESM dans le cadre d'une acquisition réelle (haut) et dans le cadre de l'utilisation d'un environnement virtuel (bas). Un VE modélise de manière comportementale la physique, à partir de l'émission des impulsions jusqu'à la caractérisation des PDW. Le périmètre du VE (encadré en pointillés bleus) comprend à la fois le périmètre du capteur (encadré en pointillés noir) et l'émission des impulsions à partir du scénario tactique. Ces PDW ainsi générés sont fidèles à ceux qui aurait été saisis lors d'une campagne d'acquisition et peuvent être utilisés pour évaluer le fonctionnement des algorithmes de post-traitement}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.6}{\ignorespaces Visualisation des fenêtres temporelles successives (délimitées en pointillés noirs) sur une séquence de PDW incidents, représentés dans un plan temps-fréquence. La couleur de chaque rectangle encode l'amplitude du PDW. Ces fenêtres peuvent être de longueur différente et comprendre un nombre de PDW différent. Par exemple la fenêtre repassée en rouge contient 5 PDW, tandis que la fenêtre repassée en vert n'en contient que 2.}}{21}{figure.caption.8}\protected@file@percent }
\newlabel{fig:palier}{{2.6}{21}{Visualisation des fenêtres temporelles successives (délimitées en pointillés noirs) sur une séquence de PDW incidents, représentés dans un plan temps-fréquence. La couleur de chaque rectangle encode l'amplitude du PDW. Ces fenêtres peuvent être de longueur différente et comprendre un nombre de PDW différent. Par exemple la fenêtre repassée en rouge contient 5 PDW, tandis que la fenêtre repassée en vert n'en contient que 2}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.4}Identification du goulot d'étranglement et limites opérationnelles}{21}{section.2.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4.1}L'impératif de temps réel et le coût de la simulation}{21}{subsection.2.4.1}\protected@file@percent }
