\@writefile{lof}{\contentsline {figure}{\numberline {2.7}{\ignorespaces Évaluation empirique du temps d'exécution du module DCI en fonction de la densité du scénario. La courbe illustre une croissance sur-linéaire, caractéristique de la complexité quadratique.}}{22}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cpuTime}{{2.7}{22}{Évaluation empirique du temps d'exécution du module DCI en fonction de la densité du scénario. La courbe illustre une croissance sur-linéaire, caractéristique de la complexité quadratique}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.5}Formalisation et complexité du problème d'apprentissage}{23}{section.2.5}\protected@file@percent }
\newlabel{seq:FormaPb}{{2.5}{23}{Formalisation et complexité du problème d'apprentissage}{section.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.8}{\ignorespaces Comparaison de la chaîne de traitement de l'information dans le VE en remplaçant le goulot d'étranglement du VE (encadré en pointillés rouges en haut) par un modèle d'IA (en bas). Les PDW générés par le VE modifié par IA doivent donc correspondre à ceux qui auraient été générés sans IA par le VE de base.}}{23}{figure.caption.10}\protected@file@percent }
\newlabel{fig:env2}{{2.8}{23}{Comparaison de la chaîne de traitement de l'information dans le VE en remplaçant le goulot d'étranglement du VE (encadré en pointillés rouges en haut) par un modèle d'IA (en bas). Les PDW générés par le VE modifié par IA doivent donc correspondre à ceux qui auraient été générés sans IA par le VE de base}{figure.caption.10}{}}
