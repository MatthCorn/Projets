\newlabel{fig:image66}{{6.10}{109}{Erreur de reconstruction en fonction de la position du PDW dans la fenêtre de génération. L'erreur est asymétrique : elle est maximale au début de la prédiction (immédiatement après le contexte) et diminue progressivement}{figure.caption.49}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5.2}Modélisation explicite de l'état mémoire}{109}{subsection.6.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.11}{\ignorespaces Preuve de concept d'une architecture Transformer modifiée, intégrant la réception d'un état mémoire explicite $m_k$ et la prédiction de son état futur $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle m_{k+1}$}\mathaccent "0362{m_{k+1}}$ pour transmission inter-fenêtres. Dans ce schéma, les dernières impulsions incidentes passées sont dénotées $sx_k^-$, les nouvelles impulsions incidentes de la fenêtre sont dénotées $sx_k$, les dernières impulsions interceptés passées sont dénotées $sy_k^-$, les nouvelles impulsions à intercepter sur la fenêtre sont dénotées $sy_k$ et les prédictions du modèle sur la fenêtre sont dénotées $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle sy_k$}\mathaccent "0362{sy_k}$}}{110}{figure.caption.50}\protected@file@percent }
\newlabel{fig:modelSSM}{{6.11}{110}{Preuve de concept d'une architecture Transformer modifiée, intégrant la réception d'un état mémoire explicite $m_k$ et la prédiction de son état futur $\widehat {m_{k+1}}$ pour transmission inter-fenêtres. Dans ce schéma, les dernières impulsions incidentes passées sont dénotées $sx_k^-$, les nouvelles impulsions incidentes de la fenêtre sont dénotées $sx_k$, les dernières impulsions interceptés passées sont dénotées $sy_k^-$, les nouvelles impulsions à intercepter sur la fenêtre sont dénotées $sy_k$ et les prédictions du modèle sur la fenêtre sont dénotées $\widehat {sy_k}$}{figure.caption.50}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.12}{\ignorespaces Répartition de l'erreur positionnelle pour un modèle classique fondé uniquement sur l'historique des PDW passés (forte asymétrie initiale).}}{111}{figure.caption.51}\protected@file@percent }
\newlabel{fig:image67}{{6.12}{111}{Répartition de l'erreur positionnelle pour un modèle classique fondé uniquement sur l'historique des PDW passés (forte asymétrie initiale)}{figure.caption.51}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.13}{\ignorespaces Répartition de l'erreur positionnelle pour le modèle disposant de l'état explicite des mémoires $m_k$. L'asymétrie initiale disparaît, l'erreur devenant constante et globalement plus faible.}}{111}{figure.caption.52}\protected@file@percent }
\newlabel{fig:image70}{{6.13}{111}{Répartition de l'erreur positionnelle pour le modèle disposant de l'état explicite des mémoires $m_k$. L'asymétrie initiale disparaît, l'erreur devenant constante et globalement plus faible}{figure.caption.52}{}}
