\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces Illustration pour un scénario fréquentiellement dense dans le plan temps-fréquence de : la séquence source (en haut à gauche), la séquence cible (en haut à droite), la séquence prédite de manière auto-régressive (en bas à gauche) et la séquence prédite en apprentissage guidé (en bas à droite). Le modèle reproduit avec succès les artéfacts de (a) fusion, (b) disparition et (d) troncature avant.}}{95}{figure.caption.38}\protected@file@percent }
\newlabel{fig:gen_short_dense}{{6.3}{95}{Illustration pour un scénario fréquentiellement dense dans le plan temps-fréquence de : la séquence source (en haut à gauche), la séquence cible (en haut à droite), la séquence prédite de manière auto-régressive (en bas à gauche) et la séquence prédite en apprentissage guidé (en bas à droite). Le modèle reproduit avec succès les artéfacts de (a) fusion, (b) disparition et (d) troncature avant}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces Illustration pour un scénario fréquentiellement clairsemé dans le plan temps-fréquence de : la séquence source (en haut à gauche), la séquence cible (en haut à droite), la séquence prédite de manière auto-régressive (en bas à gauche) et la séquence prédite en apprentissage guidé (en bas à droite). Le modèle reproduit fidèlement les artéfacts de (a) fusion, (c) scission et (e) troncature arrière.}}{96}{figure.caption.39}\protected@file@percent }
\newlabel{fig:gen_short_light}{{6.4}{96}{Illustration pour un scénario fréquentiellement clairsemé dans le plan temps-fréquence de : la séquence source (en haut à gauche), la séquence cible (en haut à droite), la séquence prédite de manière auto-régressive (en bas à gauche) et la séquence prédite en apprentissage guidé (en bas à droite). Le modèle reproduit fidèlement les artéfacts de (a) fusion, (c) scission et (e) troncature arrière}{figure.caption.39}{}}
