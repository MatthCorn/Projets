\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces Illustration pour un scénario fréquentiellement dense dans le plan temps-fréquence de : la séquence source (en haut à gauche), la séquence cible (en haut à droite), la séquence prédite de manière auto-régressive (en bas à gauche) et la séquence prédite en apprentissage guidé (en bas à droite). Le modèle reproduit avec succès les artéfacts de (a) fusion, (b) disparition et (d) troncature avant.}}{91}{figure.caption.36}\protected@file@percent }
\newlabel{fig:gen_short_dense}{{6.3}{91}{Illustration pour un scénario fréquentiellement dense dans le plan temps-fréquence de : la séquence source (en haut à gauche), la séquence cible (en haut à droite), la séquence prédite de manière auto-régressive (en bas à gauche) et la séquence prédite en apprentissage guidé (en bas à droite). Le modèle reproduit avec succès les artéfacts de (a) fusion, (b) disparition et (d) troncature avant}{figure.caption.36}{}}
