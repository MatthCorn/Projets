\@writefile{lof}{\contentsline {figure}{\numberline {6.8}{\ignorespaces Illustration dans le plan temps-fréquence de l'ensemble du scénario (500 PDW incidents), où les séquences sont reconstruites par fenêtrage glissant. On y trouve la séquence source (en haut à gauche), la séquence cible (en haut à droite), la séquence prédite de manière auto-régressive (en bas à gauche) et la séquence prédite en apprentissage guidé (en bas à droite). La densité spectrale globale et les dynamiques principales du capteur semblent visuellement préservées.}}{101}{figure.caption.44}\protected@file@percent }
\newlabel{fig:gen_win_full}{{6.8}{101}{Illustration dans le plan temps-fréquence de l'ensemble du scénario (500 PDW incidents), où les séquences sont reconstruites par fenêtrage glissant. On y trouve la séquence source (en haut à gauche), la séquence cible (en haut à droite), la séquence prédite de manière auto-régressive (en bas à gauche) et la séquence prédite en apprentissage guidé (en bas à droite). La densité spectrale globale et les dynamiques principales du capteur semblent visuellement préservées}{figure.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.9}{\ignorespaces Zoom dans l'illustration \ref {fig:gen_win_full} sur la fenêtre temporelle $[180; 265]$. Nous pouvons y observer des défauts dans les prédictions (encerclés en rouge), particulièrement pour l'inférence auto-régressive (en bas à gauche) qui s'accumule au niveau des frontières entre les différentes fenêtres (symbolisées par les traits verticaux noirs)}}{101}{figure.caption.45}\protected@file@percent }
\newlabel{fig:gen_win_zoom}{{6.9}{101}{Zoom dans l'illustration \ref {fig:gen_win_full} sur la fenêtre temporelle $[180; 265]$. Nous pouvons y observer des défauts dans les prédictions (encerclés en rouge), particulièrement pour l'inférence auto-régressive (en bas à gauche) qui s'accumule au niveau des frontières entre les différentes fenêtres (symbolisées par les traits verticaux noirs)}{figure.caption.45}{}}
