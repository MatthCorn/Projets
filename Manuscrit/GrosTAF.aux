\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces Architecture Transformer d'encodage-décodage adaptée à la transduction de séquences de PDW. La longueur $M$ est ajustée à la longueur maximale des séquences de sortie, soit $1.2N$. Chaque prédiction $\hat  {y}_k$ n'est calculée qu'à partir des PDW déjà interceptés dans sa propre temporalité $(y_1, \dots  , y_{k-1})$ et de la séquence source complète $(x_1, \dots  , x_N)$, assurant la causalité de l'opération de prédiction.}}{84}{figure.caption.32}\protected@file@percent }
\newlabel{fig:GTAFTrans}{{6.1}{84}{Architecture Transformer d'encodage-décodage adaptée à la transduction de séquences de PDW. La longueur $M$ est ajustée à la longueur maximale des séquences de sortie, soit $1.2N$. Chaque prédiction $\hat {y}_k$ n'est calculée qu'à partir des PDW déjà interceptés dans sa propre temporalité $(y_1, \dots , y_{k-1})$ et de la séquence source complète $(x_1, \dots , x_N)$, assurant la causalité de l'opération de prédiction}{figure.caption.32}{}}
