\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Illustration d'une convolution 1D standard et de l'expansion hiérarchique du champ récepteur. $y_8$ reçoit les informations de $h_7$ à $h_9$ grâce au filtre $v$. Le filtre $w$ étend le champ récepteur de $y_8$ aux entrées $x_6$ à $x_{10}$.}}{42}{figure.caption.11}\protected@file@percent }
\newlabel{convolution base}{{3.1}{42}{Illustration d'une convolution 1D standard et de l'expansion hiérarchique du champ récepteur. $y_8$ reçoit les informations de $h_7$ à $h_9$ grâce au filtre $v$. Le filtre $w$ étend le champ récepteur de $y_8$ aux entrées $x_6$ à $x_{10}$}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.2.3}Application aux structures spatiales bidimensionnelles}{42}{subsubsection.3.4.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Impact de la topologie du support de convolution sur la causalité temporelle. À gauche, les filtres de convolutions sont centrés, laissant $x_5$ et $x_6$ dans le champ récepteur de $y_4$ : la transformation n'est pas causale. À droite, tous les filtres de convolution sont causaux, restreignant le champ récepteur de $y_5$ aux éléments $x_k, \tmspace  +\thickmuskip {.2777em} k \leq 5$ : la transformation est causale.}}{43}{figure.caption.12}\protected@file@percent }
\newlabel{convolution comparaison}{{3.2}{43}{Impact de la topologie du support de convolution sur la causalité temporelle. À gauche, les filtres de convolutions sont centrés, laissant $x_5$ et $x_6$ dans le champ récepteur de $y_4$ : la transformation n'est pas causale. À droite, tous les filtres de convolution sont causaux, restreignant le champ récepteur de $y_5$ aux éléments $x_k, \; k \leq 5$ : la transformation est causale}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.2.4}Application aux séquences unidimensionnelles}{43}{subsubsection.3.4.2.4}\protected@file@percent }
