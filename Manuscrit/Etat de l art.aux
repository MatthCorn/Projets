\newlabel{seq:Transformer}{{3.4.4}{49}{L'architecture Transformer}{subsection.3.4.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.4.1}Limites de la récurrence et introduction du mécanisme d'Attention}{49}{subsubsection.3.4.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.4.2}Architecture macroscopique Encodeur-Décodeur}{50}{subsubsection.3.4.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Flux d'information macroscopique dans l'architecture Transformer Encodeur-Décodeur. Le cône bleu illustre le champ récepteur de $z_3$, agrégeant les informations de la séquence source $x_1$ à $x_7$, ainsi que les informations des éléments déjà prédits de la séquence cible $y_1$ et $y_2$ : le fonctionnement est causal.}}{51}{figure.caption.16}\protected@file@percent }
\newlabel{simple transformer}{{3.6}{51}{Flux d'information macroscopique dans l'architecture Transformer Encodeur-Décodeur. Le cône bleu illustre le champ récepteur de $z_3$, agrégeant les informations de la séquence source $x_1$ à $x_7$, ainsi que les informations des éléments déjà prédits de la séquence cible $y_1$ et $y_2$ : le fonctionnement est causal}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.4.3}L'Encodeur}{51}{subsubsection.3.4.4.3}\protected@file@percent }
\newlabel{seq:Enc}{{3.4.4.3}{51}{L'Encodeur}{subsubsection.3.4.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Architecture Transformer complète : empilement des blocs. Chaque bloc permet une comparaison "simple" entre éléments des séquences, et l'empilement des blocs permet de construire des mécanismes de comparaison de complexité croissante.}}{52}{figure.caption.17}\protected@file@percent }
\newlabel{full transformer}{{3.7}{52}{Architecture Transformer complète : empilement des blocs. Chaque bloc permet une comparaison "simple" entre éléments des séquences, et l'empilement des blocs permet de construire des mécanismes de comparaison de complexité croissante}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.4.4}Le Décodeur}{52}{subsubsection.3.4.4.4}\protected@file@percent }
\newlabel{seq:Dec}{{3.4.4.4}{52}{Le Décodeur}{subsubsection.3.4.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Architecture interne du bloc Encodeur. Elle est composée de blocs s'enchainant, permettant un encodage progressif de la séquence source.}}{53}{figure.caption.18}\protected@file@percent }
\newlabel{encoder transformer}{{3.8}{53}{Architecture interne du bloc Encodeur. Elle est composée de blocs s'enchainant, permettant un encodage progressif de la séquence source}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.4.5}Le mécanisme d'Attention et ses variantes}{53}{subsubsection.3.4.4.5}\protected@file@percent }
\newlabel{seq:attvar}{{3.4.4.5}{53}{Le mécanisme d'Attention et ses variantes}{subsubsection.3.4.4.5}{}}
\newlabel{attentionscore}{{3.3}{53}{Le mécanisme d'Attention et ses variantes}{equation.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces Architecture interne du bloc Décodeur. Elle est constituée de blocs qui s'enchainent, encodant progressivement la séquence cible en y ajoutant les informations d'une séquence source (Multi-Head Cross Attention) et en comparant les éléments entre eux (Masked Multi-Head Attention).}}{54}{figure.caption.19}\protected@file@percent }
\newlabel{decoder transformer}{{3.9}{54}{Architecture interne du bloc Décodeur. Elle est constituée de blocs qui s'enchainent, encodant progressivement la séquence cible en y ajoutant les informations d'une séquence source (Multi-Head Cross Attention) et en comparant les éléments entre eux (Masked Multi-Head Attention)}{figure.caption.19}{}}
\newlabel{pondatt}{{3.4}{54}{Le mécanisme d'Attention et ses variantes}{equation.3.4}{}}
\newlabel{attentionoperator}{{3.5}{54}{Le mécanisme d'Attention et ses variantes}{equation.3.5}{}}
\newlabel{queryeq}{{3.6}{54}{Le mécanisme d'Attention et ses variantes}{equation.3.6}{}}
\newlabel{MHAeq}{{3.8}{55}{Le mécanisme d'Attention et ses variantes}{equation.3.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.10}{\ignorespaces Illustration de l'Attention Croisée ($\mathsf  {MHCA}$). Les requêtes (en bleu) proviennent de la séquence cible et interrogent l'intégralité du contexte source (clés en jaune). À gauche, la requête $q_3$ agrège l'information de la séquence source (à l'origine des clés et valeurs $\mathcal  {KV})$) pour construire $A(q_3,\mathcal  {KV})) $, représenté dans la cellule verte. Le cône d'interaction est représenté en dégradé de bleu. À droite, le même calcul est effectué indépendamment pour la requête $q_5$. Cette indépendance des calculs permet leur parallélisation.}}{56}{figure.caption.20}\protected@file@percent }
\newlabel{fig:cross_att}{{3.10}{56}{Illustration de l'Attention Croisée ($\mathsf {MHCA}$). Les requêtes (en bleu) proviennent de la séquence cible et interrogent l'intégralité du contexte source (clés en jaune). À gauche, la requête $q_3$ agrège l'information de la séquence source (à l'origine des clés et valeurs $\mathcal {KV})$) pour construire $A(q_3,\mathcal {KV})) $, représenté dans la cellule verte. Le cône d'interaction est représenté en dégradé de bleu. À droite, le même calcul est effectué indépendamment pour la requête $q_5$. Cette indépendance des calculs permet leur parallélisation}{figure.caption.20}{}}
\newlabel{maskedattention}{{3.9}{56}{Le mécanisme d'Attention et ses variantes}{equation.3.9}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.4.6}Invariance par permutation et Encodage Positionnel}{56}{subsubsection.3.4.4.6}\protected@file@percent }
\newlabel{seq:PE}{{3.4.4.6}{56}{Invariance par permutation et Encodage Positionnel}{subsubsection.3.4.4.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.11}{\ignorespaces Comparaison des modes d'Auto-Attention. La séquence d'entré nourrit à la fois $\mathcal  {Q}$ et $\mathcal  {KV}$. À gauche, l'interaction est globale. La requête $q_4$ agrège l'information de toute la séquence pour construire $A(q_4,\mathcal  {KV}))$, représenté dans la cellule verte. Le cône d'interaction est représenté en dégradé de bleu. À droite, l'interaction est causale. L'accès aux clés futures est donc bloqué (score $-\infty $), cette restriction est visible sur le cône d'interaction en nuance de bleu. La requête $q_4$ agrège aux positions $j \le 4$ pour construire $A(q_4,\mathcal  {KV}))$, qui constitue une prédiction des états futurs. Pour les deux images, on représente en arrière plan les même calculs pour la requête $q_6$, réalisés de manière indépendante.}}{57}{figure.caption.21}\protected@file@percent }
\newlabel{fig:compare_att}{{3.11}{57}{Comparaison des modes d'Auto-Attention. La séquence d'entré nourrit à la fois $\mathcal {Q}$ et $\mathcal {KV}$. À gauche, l'interaction est globale. La requête $q_4$ agrège l'information de toute la séquence pour construire $A(q_4,\mathcal {KV}))$, représenté dans la cellule verte. Le cône d'interaction est représenté en dégradé de bleu. À droite, l'interaction est causale. L'accès aux clés futures est donc bloqué (score $-\infty $), cette restriction est visible sur le cône d'interaction en nuance de bleu. La requête $q_4$ agrège aux positions $j \le 4$ pour construire $A(q_4,\mathcal {KV}))$, qui constitue une prédiction des états futurs. Pour les deux images, on représente en arrière plan les même calculs pour la requête $q_6$, réalisés de manière indépendante}{figure.caption.21}{}}
\newlabel{eq:PE}{{3.10}{57}{Invariance par permutation et Encodage Positionnel}{equation.3.10}{}}
