\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.3.1}Évolution architecturale : des RNN simples aux portes logiques (LSTM/GRU)}{45}{subsubsection.3.4.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.3.2}Principe de récurrence et mise à jour de l'état mémoire}{45}{subsubsection.3.4.3.2}\protected@file@percent }
\newlabel{seq:RNNPrincipe}{{3.4.3.2}{45}{Principe de récurrence et mise à jour de l'état mémoire}{subsubsection.3.4.3.2}{}}
\newlabel{eq:recurrent}{{3.1}{46}{Principe de récurrence et mise à jour de l'état mémoire}{equation.3.1}{}}
\newlabel{eq:RNN}{{3.2}{46}{Principe de récurrence et mise à jour de l'état mémoire}{equation.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Illustration du mécanisme de la récurrence et propagation de l'état mémoire. $W_1$ joue le rôle de contrôleur la persistance de la mémoire $h$, noté $W_{hh}$ dans l'équation \ref {eq:RNN}. $W_2$ joue le rôle de projeteur des éléments de la séquence d'entrée $x$ dans l'espace latent, noté $W_{ih}$ dans l'équation \ref {eq:RNN}. Le cône bleu représente le champ récepteur de $h_3$, qui va de $x_1$ à $x_3$. En arrière plan, le cône bleu pâle représente le champ récepteur de $h_9$, s'étendant de $x_1$ à $x_9$.}}{47}{figure.caption.14}\protected@file@percent }
\newlabel{RNN base}{{3.4}{47}{Illustration du mécanisme de la récurrence et propagation de l'état mémoire. $W_1$ joue le rôle de contrôleur la persistance de la mémoire $h$, noté $W_{hh}$ dans l'équation \ref {eq:RNN}. $W_2$ joue le rôle de projeteur des éléments de la séquence d'entrée $x$ dans l'espace latent, noté $W_{ih}$ dans l'équation \ref {eq:RNN}. Le cône bleu représente le champ récepteur de $h_3$, qui va de $x_1$ à $x_3$. En arrière plan, le cône bleu pâle représente le champ récepteur de $h_9$, s'étendant de $x_1$ à $x_9$}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.3.3}Modèles d'Espaces d'États (SSM)}{47}{subsubsection.3.4.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Topologies d'application des architectures récurrentes : traitement de flux (gauche) et traduction globale (droite). Les matrices $W_1$ et $W_4$ sont les matrices de persistance de la mémoire (notées $W_{hh}$ dans \ref {eq:RNN}). Les matrices $W_2$ et $W_5$ sont les matrices de projections vers l'espace latent (notées $W_{ih}$ dans \ref {eq:RNN}) . La matrice $W_3$ est une matrice de projection dans l'espace des prédiction.}}{48}{figure.caption.15}\protected@file@percent }
\newlabel{RNN comparaison}{{3.5}{48}{Topologies d'application des architectures récurrentes : traitement de flux (gauche) et traduction globale (droite). Les matrices $W_1$ et $W_4$ sont les matrices de persistance de la mémoire (notées $W_{hh}$ dans \ref {eq:RNN}). Les matrices $W_2$ et $W_5$ sont les matrices de projections vers l'espace latent (notées $W_{ih}$ dans \ref {eq:RNN}) . La matrice $W_3$ est une matrice de projection dans l'espace des prédiction}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.3.4}Traitement du langage naturel et architectures Sequence-to-Sequence}{48}{subsubsection.3.4.3.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.3.5}AApplication aux systèmes dynamiques et temporels continus}{49}{subsubsection.3.4.3.5}\protected@file@percent }
