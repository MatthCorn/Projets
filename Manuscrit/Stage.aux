\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Représentation du cœur des trois principales architectures comparées. Chaque architecure dispose d'une mémoire latente $h_t$ qu'elle met à jour à partir d'une entrée courante $x_t$ et qu'elle peut exploiter pour produire une prédiction. source : \textit  {https://colah.github.io/posts/2015-08-Understanding-LSTMs/}}}{107}{figure.caption.46}\protected@file@percent }
\newlabel{fig:compareRNN}{{7.1}{107}{Représentation du cœur des trois principales architectures comparées. Chaque architecure dispose d'une mémoire latente $h_t$ qu'elle met à jour à partir d'une entrée courante $x_t$ et qu'elle peut exploiter pour produire une prédiction. source : \textit {https://colah.github.io/posts/2015-08-Understanding-LSTMs/}}{figure.caption.46}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7.2}{\ignorespaces Configurations optimales des architectures évaluées.}}{107}{table.caption.47}\protected@file@percent }
