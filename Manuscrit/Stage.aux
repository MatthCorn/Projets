\@writefile{lof}{\contentsline {figure}{\numberline {7.5}{\ignorespaces Schéma des structures neuronales qui précèdent (à gauche) et succèdent (à droite) le cœur du modèle (constitué soit d'une GRU, TCN ou Transformer). Les opérations réalisés dans ces modules sont appliquées aux éléments indépendamment, contrairement au cœur du modèle qui constitue le module du traitement de séquence. La séquence prise pour exemple correspond à la séquence \ref {tab:seqfusion}.}}{113}{figure.caption.52}\protected@file@percent }
\newlabel{fig:LinProcess}{{7.5}{113}{Schéma des structures neuronales qui précèdent (à gauche) et succèdent (à droite) le cœur du modèle (constitué soit d'une GRU, TCN ou Transformer). Les opérations réalisés dans ces modules sont appliquées aux éléments indépendamment, contrairement au cœur du modèle qui constitue le module du traitement de séquence. La séquence prise pour exemple correspond à la séquence \ref {tab:seqfusion}}{figure.caption.52}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.4.2.1}Erreur de reconstruction pondérée ($\mathcal  {L}_{reg}$)}{113}{subsubsection.7.4.2.1}\protected@file@percent }
\newlabel{eq:loss}{{7.4}{114}{Erreur de reconstruction pondérée ($\mathcal {L}_{reg}$)}{equation.7.4}{}}
