\@writefile{lot}{\contentsline {table}{\numberline {7.2}{\ignorespaces Compilation de l'ensemble des données (entrées, sortie, masques) qui permettent de superviser l'entrainement d'un modèle. Dans cet exemple, la séquence sérialisée \eqref  {eq:seqfusion} est de longueur 8 mais est prolongée jusqu'à 10, ce qui correspond à l'étape d'uniformisation des longueurs des séquences permettant un entrainement en parallèle de nos modèles.}}{118}{table.caption.55}\protected@file@percent }
\newlabel{tab:seqfusion2}{{7.2}{118}{Compilation de l'ensemble des données (entrées, sortie, masques) qui permettent de superviser l'entrainement d'un modèle. Dans cet exemple, la séquence sérialisée \eqref {eq:seqfusion} est de longueur 8 mais est prolongée jusqu'à 10, ce qui correspond à l'étape d'uniformisation des longueurs des séquences permettant un entrainement en parallèle de nos modèles}{table.caption.55}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3.1}Configurations architecturales}{118}{subsection.7.3.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7.3}{\ignorespaces Configurations optimales des architectures récurrentes évaluées.}}{118}{table.caption.58}\protected@file@percent }
\newlabel{tab:hypRNN}{{7.3}{118}{Configurations optimales des architectures récurrentes évaluées}{table.caption.58}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Représentation du cœur des trois principales architectures comparées. Chaque architecure dispose d'une mémoire latente $h_t$ qu'elle met à jour à partir d'une entrée courante $x_t$ et qu'elle peut exploiter pour produire une prédiction. source : \textit  {https://colah.github.io/posts/2015-08-Understanding-LSTMs/}}}{119}{figure.caption.56}\protected@file@percent }
\newlabel{fig:compareRNN}{{7.1}{119}{Représentation du cœur des trois principales architectures comparées. Chaque architecure dispose d'une mémoire latente $h_t$ qu'elle met à jour à partir d'une entrée courante $x_t$ et qu'elle peut exploiter pour produire une prédiction. source : \textit {https://colah.github.io/posts/2015-08-Understanding-LSTMs/}}{figure.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces Illustration d'un réseau récurrent adapté au traitement de flux. Il est constitué de $L=3$ couches. La matrice $W_2$ est la matrice de projection vers l’espace latent. Les matrices $W_1^1$, $W_1^2$ et $W_1^3$ sont la matrice de persistance de la mémoire pour les 3 couches du modèle. La matrice $W_3$ est une matrice de projection dans l’espace des prédiction.}}{119}{figure.caption.57}\protected@file@percent }
\newlabel{fig:fluxaflux}{{7.2}{119}{Illustration d'un réseau récurrent adapté au traitement de flux. Il est constitué de $L=3$ couches. La matrice $W_2$ est la matrice de projection vers l’espace latent. Les matrices $W_1^1$, $W_1^2$ et $W_1^3$ sont la matrice de persistance de la mémoire pour les 3 couches du modèle. La matrice $W_3$ est une matrice de projection dans l’espace des prédiction}{figure.caption.57}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3.2}La métrique}{120}{subsection.7.3.2}\protected@file@percent }
