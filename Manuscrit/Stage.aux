\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Illustration de l'architecture Transformer utilisé pour le traitement flux-à-flux, où l'auto-attention de référence \ref {encoder transformer} est remplacée par de l'auto-attention masquée.}}{106}{figure.caption.46}\protected@file@percent }
\newlabel{fig:linTrans}{{7.3}{106}{Illustration de l'architecture Transformer utilisé pour le traitement flux-à-flux, où l'auto-attention de référence \ref {encoder transformer} est remplacée par de l'auto-attention masquée}{figure.caption.46}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces Comparaison structurelle des architectures convolutives unidimensionnelles. À gauche (a), une convolution causale standard où l'horizon d'interaction croît linéairement avec la profondeur. À droite (b), une convolution causale dilatée où le facteur de dilatation $d$ croît exponentiellement ($d=1, 2, 4$). Figure reproduite d'après \blx@tocontentsinit {0}\cite {bai_empirical_2018}.}}{107}{figure.caption.47}\protected@file@percent }
\newlabel{fig:TCN}{{7.4}{107}{Comparaison structurelle des architectures convolutives unidimensionnelles. À gauche (a), une convolution causale standard où l'horizon d'interaction croît linéairement avec la profondeur. À droite (b), une convolution causale dilatée où le facteur de dilatation $d$ croît exponentiellement ($d=1, 2, 4$). Figure reproduite d'après \cite {bai_empirical_2018}}{figure.caption.47}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.4.1.3}Le GRU (Recurrent Network)}{107}{subsubsection.7.4.1.3}\protected@file@percent }
