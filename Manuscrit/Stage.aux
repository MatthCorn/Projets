\@writefile{lof}{\contentsline {figure}{\numberline {7.5}{\ignorespaces Schéma des structures neuronales qui précèdent (à gauche) et succèdent (à droite) le cœur du modèle (constitué soit d'une GRU, TCN ou Transformer). Les opérations réalisés dans ces modules sont appliquées aux éléments indépendamment, contrairement au cœur du modèle qui constitue le module du traitement de séquence. La séquence prise pour exemple correspond à la séquence \ref {tab:seqfusion}.}}{109}{figure.caption.48}\protected@file@percent }
\newlabel{fig:LinProcess}{{7.5}{109}{Schéma des structures neuronales qui précèdent (à gauche) et succèdent (à droite) le cœur du modèle (constitué soit d'une GRU, TCN ou Transformer). Les opérations réalisés dans ces modules sont appliquées aux éléments indépendamment, contrairement au cœur du modèle qui constitue le module du traitement de séquence. La séquence prise pour exemple correspond à la séquence \ref {tab:seqfusion}}{figure.caption.48}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.4.2.1}Erreur de reconstruction pondérée ($\mathcal  {L}_{reg}$)}{109}{subsubsection.7.4.2.1}\protected@file@percent }
\newlabel{eq:loss}{{7.4}{110}{Erreur de reconstruction pondérée ($\mathcal {L}_{reg}$)}{equation.7.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.4.2.2}Erreur de classification par MCC différentiable ($\mathcal  {L}_{class}$)}{110}{subsubsection.7.4.2.2}\protected@file@percent }
