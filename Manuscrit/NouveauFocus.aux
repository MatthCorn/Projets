\newlabel{chap:newfocus}{{4}{61}{Conception d'un environnement d'étude contrôlé : le Module de Détection et Caractérisation des Impulsions Simplifié (DCIS)}{chapter.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.1}Contexte et motivations}{61}{section.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Illustration de l'évolution de l'erreur d'un modèle Transformer sur la tâche de génération de séquences de PDW au cours de nos premières expérimentations. Sans nécessiter la compréhension détaillée de la métrique ou de l'implémentation à ce stade, la simple proximité entre la courbe d'erreur du réseau et la courbe de référence (en noir) suffit à mettre en évidence l'incapacité de l'architecture à modéliser la logique de transduction.}}{62}{figure.caption.22}\protected@file@percent }
\newlabel{fig:errini}{{4.1}{62}{Illustration de l'évolution de l'erreur d'un modèle Transformer sur la tâche de génération de séquences de PDW au cours de nos premières expérimentations. Sans nécessiter la compréhension détaillée de la métrique ou de l'implémentation à ce stade, la simple proximité entre la courbe d'erreur du réseau et la courbe de référence (en noir) suffit à mettre en évidence l'incapacité de l'architecture à modéliser la logique de transduction}{figure.caption.22}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Architecture et modélisation algorithmique du DCIS}{62}{section.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.1}Génération de l'environnement : la séquence d'impulsions incidentes}{63}{subsection.4.2.1}\protected@file@percent }
\@writefile{loa}{\contentsline {algocf}{\numberline {1}{\ignorespaces Génération stochastique de la séquence d'impulsions incidentes}}{63}{algocf.1}\protected@file@percent }
\newlabel{algo:generation_sequence_scenario}{{1}{63}{Génération de l'environnement : la séquence d'impulsions incidentes}{algocf.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Comparaison de la structuration temporelle entre un scénario classique (gauche) et la modélisation DCIS (droite). Les fenêtres temporelles successives (paliers), délimitées en pointillés noirs, mettent en évidence la discrétisation événementielle du flux.}}{64}{figure.caption.24}\protected@file@percent }
\newlabel{fig:compPalier}{{4.2}{64}{Comparaison de la structuration temporelle entre un scénario classique (gauche) et la modélisation DCIS (droite). Les fenêtres temporelles successives (paliers), délimitées en pointillés noirs, mettent en évidence la discrétisation événementielle du flux}{figure.caption.24}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.2}Filtre de Détection Non-Ambiguë (DNA)}{64}{subsection.4.2.2}\protected@file@percent }
\newlabel{seq:DNA_DCIS}{{4.2.2}{64}{Filtre de Détection Non-Ambiguë (DNA)}{subsection.4.2.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.3}Simulation de l'acquisition et du suivi temporel}{65}{subsection.4.2.3}\protected@file@percent }
\newlabel{seq:DCISsuivi}{{4.2.3}{65}{Simulation de l'acquisition et du suivi temporel}{subsection.4.2.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.3}Validation de la modélisation}{66}{section.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Représentation dans un plan temps-fréquence des PDW entrant dans le DCIS (à gauche) et sortant de ce module (à droite) simplifiant la modélisation du processus de DCI. La couleur de chaque rectangle encode l'amplitude du PDW. Les annotations identifient les dégradations structurelles induites par le traitement : (a) Fusion de signaux distincts, (b) Disparition d'impulsion (non-détection), (c) Scission artificielle d'une impulsion continue, (d) Troncature avant, (e) Troncature arrière, comme dans \ref {fig:IOex}}}{66}{figure.caption.26}\protected@file@percent }
\newlabel{fig:IOsimple}{{4.3}{66}{Représentation dans un plan temps-fréquence des PDW entrant dans le DCIS (à gauche) et sortant de ce module (à droite) simplifiant la modélisation du processus de DCI. La couleur de chaque rectangle encode l'amplitude du PDW. Les annotations identifient les dégradations structurelles induites par le traitement : (a) Fusion de signaux distincts, (b) Disparition d'impulsion (non-détection), (c) Scission artificielle d'une impulsion continue, (d) Troncature avant, (e) Troncature arrière, comme dans \ref {fig:IOex}}{figure.caption.26}{}}
